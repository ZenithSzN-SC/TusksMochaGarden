<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="card_form" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#cardTapped" prefHeight="186.0" prefWidth="200.0" style="-fx-cursor: hand;" stylesheets="@cardDesign.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tusksmochagarden.controller.CardProductController">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <StackPane prefHeight="110.0" styleClass="card-img-holder">
                    <children>
                        <ImageView fx:id="prod_imageView" fitHeight="96.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </StackPane>
                <VBox spacing="2.0">
                    <children>
                        <Label fx:id="prod_name" styleClass="card-name" text="Product Name" wrapText="true" />
                        <Label fx:id="prod_price" styleClass="card-price" text="£0.00" />
                    </children>
                    <padding>
                        <Insets bottom="12.0" left="14.0" right="14.0" top="8.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
    <styleClass>
        <String fx:value="card" />
        <String fx:value="shadow" />
    </styleClass>
</AnchorPane>
